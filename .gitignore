.DS_Store
node_modules/
.hyperframes/

# 교과서 원문은 올리지 않는다 (형식 · 목차 · 예시 원고만 올림)
/textbook/
docs/textbook/*
!docs/textbook/_format.md
!docs/textbook/index.md
!docs/textbook/sample-unit.md

# 영상 한 편 = out/ 폴더 하나. 교과서 원문이 들어 있어서 올리지 않는다
out/

# 레퍼런스 원본(영상 · 이미지)은 남이 만든 것이라 올리지 않는다 (분석 문서만 올림)
references/**/*.mp4
references/**/*.mov
references/**/*.webm
references/**/*.jpg
references/**/*.jpeg
references/**/*.png
references/**/*.gif
references/**/*.webp

# 내려받은 HyperFrames 스킬은 skills-lock.json 으로 다시 설치한다 (.claude/skills 의 링크도 이 컴퓨터 경로라 올리지 않음)
.agents/
.claude/skills/*
!.claude/skills/make-video/
